 "html": "<div class=\"\">\n    <table class=\"\" style=\"width: 100%; padding: 10px 2px 0px 0px !important;\">\n        <tr>\n            <td style=\"width: 33%; \">\n                <div>\n                    <b>Customer Name</b><br>{{ doc.customer_name }}<br>\n                </div>\n                <div>\n                    <b>Customer Tax Id</b><br>{{ doc.tax_id }}<br>\n                </div>\n                <div>\n                    <b>Contact Email</b><br>{{ doc.contact_email }}<br>\n                </div>\n                <div>\n                    <b>Mobile No</b><br>{{ doc.contact_mobile }}<br>\n                </div>\n                <div>\n                    <b>Customer Address</b><br>{{ doc.address_display }}\n                </div>\n            </td>\n            \n\n            <td style=\"width: 34%;\">\n                <div>\n                    <b>Invoice#</b><br>{{ doc.name }}<br>\n                </div>\n                <div>\n                    <b>Billed by</b><br>{{ \"Furqan Asghar\" }}<br>\n                </div>\n                <div>\n                    <b>Tax ID</b><br>{{ doc.company_tax_id }}<br>\n                </div>\n                <div>\n                    <b>Address</b><br>{{ doc.dispatch_address or doc.company_address_display }}\n                </div>\n            </td>\n            \n            <td style=\"width: 34%;\">\n                <div>\n                    <b>Invoice Date</b><br>{{ doc.posting_date }}<br>\n                </div>\n                <div>\n                    <b>Payment Due Date</b><br>{{ doc.due_date }}<br>\n                </div>\n            </td>\n\n        </tr>\n    </table>\n    \n    <br>\n    \n    <table style=\"width: 100%;\">\n        <thead>\n            <tr style=\"border-top: 1px solid #000; border-bottom: 1px solid #000;\">\n                <td style=\"font-weight: bold;\">No.</td>    \n                <td style=\"width:25%; font-weight: bold;\">Project</td>\n                <td style=\"width:45%; font-weight: bold;\">Project Name</td> \n                <td style=\"width:10%; font-weight: bold;\">Billed Hours</td>\n                <td style=\"width:20%; font-weight: bold;\">Amount</td>\n            </tr>\n        </thead>\n        <tbody>\n            {% for i in doc.items %}\n            <tr style=\"border-top: 1px solid #000; border-bottom: 1px solid #000;\">\n                <td style=\"\">{{i.idx}}</td>\n                <td style=\"\">{{i.custom_phamos_project}}</td>\n                <td style=\"\">{{i.custom_phamos_project_name}}</td>\n                <td style =\"text-align: right;\">{{frappe.format(i.custom_billable_hours, \"Float\")}}</td>\n                <td style=\"text-align: right;\">{{frappe.format(i.amount, \"Float\")}}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table>\n        <tr>\n            <td style=\"width:70%;\">\n                {{ doc.terms }}\n            </td>\n            <td style=\"width:30%;\">\n                <div>\n                    <b>Total Working Hours</b><br>{{ doc.get_formatted(\"custom_total_billed_hours\") }}<br>\n                </div>\n                <div>\n                    <b>Grand Total</b><br>{{ doc.get_formatted(\"grand_total\") }}<br>\n                </div>\n                <div>\n                    <b>In Words</b><br>{{ doc.in_words }}<br>\n                </div>\n            </td>\n        </tr>\n    </table>\n\n</div>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    <div style=\"font-size:8px\">\n        <table style=\"width: 100%;\">\n            <tr>\n                <td style=\"width:25%;\">{{ doc.dispatch_address or doc.company_address_display }}</td>\n                <td style=\"width:25%;\"><p>Mobile: +923002716389</p> <p>Email: furqan.79000@gmail.com</p></td>\n                <td style=\"width:25%;\"><p>Software Developer:Furqan Asghar</p><p>VAT ID: 4230127491463</p></td>\n                <td style=\"width:25%;\"><p>Bank name: HABIBMETRO</p><p>Account Title: FURQAN ASGHAR</p><p>IBAN: PK09MPBL0167027140126402</p>\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>",
